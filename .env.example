# Plantilla de configuración. Copiar como .env (que NO se versiona) y completar.
# El notebook lee este archivo al iniciar. Si la variable ya existe en el entorno, tiene prioridad.

# URI del tracking server de MLflow.
#   Servidor:     MLFLOW_TRACKING_URI=http://<host>:<puerto>
#   Prueba local: MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_TRACKING_URI=REEMPLAZAR-CON-EL-URI-DEL-SERVIDOR

# Solo si el servidor exige autenticación (nunca subir valores reales al repo):
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MLFLOW_TRACKING_TOKEN=

# Silencia un aviso informativo de MLflow al importar
MLFLOW_DISABLE_AGENT_HINT=1
